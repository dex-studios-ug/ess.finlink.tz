# Security Configuration
PRIVATE_KEY_PATH=./certs/fsp_private.pem
PUBLIC_KEY_PATH=./certs/fsp_public.pem
KEY_PASSPHRASE=your-passphrase-here

# CORS Configuration
ALLOWED_ORIGINS=*
#https://utumishi.go.tz,https://ess.utumishi.go.tz
