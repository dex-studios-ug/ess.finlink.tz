# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=emokopo-fsp-bridge-jwt-secret-key-2024-change-in-production

# FSP Configuration
FSP_CODE=FL7407
FSP_NAME="Your Financial Institution"

# MifosX Configuration
MIFOSX_BASE_URL=https://postakkselfservice.finlinktz.net/fineract-provider/api/v1
MIFOSX_TENANT_ID=default
MIFOSX_USERNAME=Leon
MIFOSX_PASSWORD=Kaitesi
