{
  "name": "emokopo-fsp-bridge",
  "version": "1.0.0",
  "description": "e-MKOPO FSP Bridge Server for MifosX Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:crdb\"",
    "dev:server": "nodemon server.js",
    "dev:client": "vite",
    "dev:crdb": "nodemon crdb.js",
    "test": "jest",
    "security-audit": "npm audit",
    "lint": "eslint server.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "md5": "^2.3.0",
    "morgan": "^1.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sha1": "^1.1.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "uuid": "9.0.1",
    "vite": "^8.0.3",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
